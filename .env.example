# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file.

# Primary LLM provider (free models): https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Fallback LLM provider: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# PostgreSQL for conversation memory, chat titles and skill tracking.
# Neon (https://neon.tech): Project Dashboard -> "Connect" -> copy the FULL
# connection string. Keep every parameter it includes (sslmode, channel_binding).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Alternative to DATABASE_URL: a local PostgreSQL (leave DATABASE_URL unset)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=techmate_db